\name{gtheoryr-package}
\alias{gtheoryr-package}
\alias{gtheoryr}
\title{gtheoryr: Simple Generalizability Theory for R}
\description{
Small, beginner-friendly helpers for estimating variance components in simple
generalizability theory designs. The package currently supports:
\itemize{
  \item a crossed persons-by-items design via \code{gstudy_pxi()}
  \item generic balanced crossed designs with one or more facets via \code{gstudy_crossed()}
  \item a crossed persons-by-items-by-facet design via \code{gstudy_pxif()}
  \item convenience wrappers for raters and occasions via \code{gstudy_pxir()} and \code{gstudy_pxio()}
  \item convenience wrappers for persons-by-items-by-raters-by-occasions designs via \code{gstudy_pxiro()}
  \item a nested items-within-person design via \code{gstudy_nested_ip()}
  \item simple D-studies via \code{dstudy_pxi()}, \code{dstudy_crossed()}, \code{dstudy_pxif()}, \code{dstudy_pxir()}, \code{dstudy_pxio()}, \code{dstudy_pxiro()}, and \code{dstudy_nested_ip()}
  \item table extractors via \code{anova_table()}, \code{mean_squares_table()}, \code{variance_components_table()}, and \code{variance_proportions_table()}
}
}
\docType{package}
